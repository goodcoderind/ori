#############################################
# ====== PROSOCRATIC BACKEND ENV ====== #
#############################################

# -----------------------------
# App Configuration
# -----------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# -----------------------------
# API Base Configuration
# -----------------------------
API_VERSION=v1
DASHBOARD_ORIGIN=http://localhost:3000
EXTENSION_DEV_MODE=true

# -----------------------------
# MiniMax Configuration
# -----------------------------
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_TEMPERATURE=0.4
MINIMAX_MAX_TOKENS=1024
MINIMAX_TIMEOUT_SECONDS=20

# -----------------------------
# AWS Configuration
# -----------------------------
AWS_REGION=me-central-1

# Local development — use AWS CLI credentials or set explicitly:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# -----------------------------
# DynamoDB Table Names
# -----------------------------
TABLE_USERS=ProsocraticUsers
TABLE_SESSIONS=ProsocraticSessions
TABLE_ASSESSMENTS=ProsocraticAssessments

# -----------------------------
# Lambda / Deployment
# -----------------------------
LAMBDA_TIMEOUT_SECONDS=30
ENABLE_LAMBDA_MODE=false

# -----------------------------
# Rate Limiting
# -----------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# -----------------------------
# Privacy & Storage Controls
# MUST remain false — server raises on startup if either is true
# -----------------------------
STORE_RAW_ANSWERS=false
STORE_PAGE_CONTEXT=false
SESSION_TTL_DAYS=30

#############################################
# END OF CONFIG
#############################################
